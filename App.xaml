<Application x:Class="MentionedMe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Theme/Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Wpf.Ui;component/Resources/Wpf.Ui.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Accent and Glow Brushes -->
            <SolidColorBrush x:Key="AccentCyanBrush" Color="#00D2FF" />
            <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#10B981" />
            <SolidColorBrush x:Key="AccentRoseBrush" Color="#F43F5E" />
            <SolidColorBrush x:Key="CardDarkBrush" Color="#1E222B" />
            <SolidColorBrush x:Key="CardDarkBorderBrush" Color="#2D3342" />
            <SolidColorBrush x:Key="TextSubtleBrush" Color="#94A3B8" />

            <Style x:Key="GlowCard" TargetType="Border">
                <Setter Property="Background" Value="#181B22" />
                <Setter Property="BorderBrush" Value="#282E3D" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
