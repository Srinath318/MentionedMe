<Window x:Class="MentionedMe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:MentionedMe.Converters"
        mc:Ignorable="d"
        Title="Mentioned Me? — Did someone mention me?" 
        Height="780" Width="880"
        MinHeight="620" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="#0F1319"
        Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Topmost="{Binding KeepWindowAlwaysOnTop}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
        <converters:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis" Invert="True" />
        <converters:CountToVisibilityConverter x:Key="CountToVis" />
        <converters:CountToVisibilityConverter x:Key="InverseCountToVis" Invert="True" />
        <converters:AudioLevelToWidthConverter x:Key="LevelToWidth" />

        <!-- ScrollViewer borderless clean style -->
        <Style TargetType="ScrollViewer">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Glow animations -->
        <Storyboard x:Key="PulseGlow" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.4" To="1.0" Duration="0:0:1.2" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Main Application Shell -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Error banner -->
                <RowDefinition Height="*" />    <!-- Content Body -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- App Icon / Badge -->
                        <Border Background="#1E293B" CornerRadius="10" Width="38" Height="38" Margin="0,0,12,0" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="🎙️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        
                        <StackPanel>
                            <TextBlock Text="Mentioned Me?" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                            <TextBlock Text="Did someone mention me?" FontSize="13" FontStyle="Italic" Foreground="#94A3B8" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Right Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Combined Start/Stop Toggle Button (replaces separate status badge + hero button) -->
                    <Button Command="{Binding ToggleListeningCommand}"
                            IsEnabled="{Binding CanToggleListening}"
                            Height="36" Margin="0,0,10,0" Cursor="Hand"
                            Padding="14,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="20"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Background" Value="#064E3B" />
                                        <Setter Property="BorderBrush" Value="#059669" />
                                        <Setter Property="BorderThickness" Value="1" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Dot indicator (green pulse when listening, play icon when stopped) -->
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <Setter Property="Text" Value="●" />
                                                <Setter Property="Foreground" Value="#10B981" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Start Listening" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <Setter Property="Text" Value="Listening · Stop" />
                                                <Setter Property="Foreground" Value="#34D399" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <!-- Settings Button -->
                    <Button Command="{Binding ToggleSettingsCommand}"
                            Background="#1E293B" Foreground="#F1F5F9"
                            BorderBrush="#334155" BorderThickness="1"
                            Padding="12,7" Height="36" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" Margin="0,0,6,0" FontSize="13" />
                            <TextBlock Text="Settings" FontSize="12" FontWeight="Medium" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Error Banner -->
            <Border Grid.Row="1" Background="#4C0519" BorderBrush="#BE123C" BorderThickness="1"
                    CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" Margin="0,0,8,0" FontSize="14" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECDD3" FontSize="13" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding DismissErrorCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#FDA4AF"
                            Content="✕" Cursor="Hand" FontWeight="Bold" Margin="8,0,0,0" />
                </Grid>
            </Border>

            <!-- 3. Main Content Split -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" /> <!-- Left Control Area -->
                    <ColumnDefinition Width="18" />   <!-- Gap -->
                    <ColumnDefinition Width="*" />   <!-- Right Mentions Feed -->
                </Grid.ColumnDefinitions>

                <!-- Left Column: Names + Privacy -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Names Card (fixed size) -->
                        <RowDefinition Height="*" />    <!-- Spacer -->
                        <RowDefinition Height="Auto" /> <!-- Bottom Privacy Badge -->
                    </Grid.RowDefinitions>

                    <!-- Names Card (fixed height — max 5 items) -->
                    <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                            CornerRadius="14" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Names" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TargetNamesCountText}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                            </Grid>

                            <!-- Vertical Name List (single column, each name on one line) -->
                            <ItemsControl ItemsSource="{Binding TargetNames}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                CornerRadius="8" Padding="10,6" Margin="0,0,0,4" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.EditNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding DataContext.RemoveNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#64748B" FontSize="11" FontWeight="Bold"
                                                        Cursor="Hand" VerticalAlignment="Center" Padding="4,0" Margin="8,0,0,0">
                                                    <TextBlock Text="✕" FontSize="10" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Name Input Row (always visible if < 5 names) -->
                            <Grid Margin="0,2,0,0" Visibility="{Binding CanAddMoreNames, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding NewNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" FontWeight="Medium"
                                         Background="#0D1117" Foreground="#FFFFFF"
                                         BorderBrush="#3B82F6" BorderThickness="1.5"
                                         Padding="10,7" Margin="0,0,6,0"
                                         CaretBrush="#60A5FA">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddNameCommand}" />
                                    </TextBox.InputBindings>
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <Button Grid.Column="1" Command="{Binding AddNameCommand}"
                                        IsEnabled="{Binding CanAddName}"
                                        Content="+ Add" FontSize="12" FontWeight="SemiBold"
                                        Background="#2563EB" Foreground="#FFFFFF"
                                        BorderThickness="0" Padding="12,0" Height="34"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Status text (shown when listening) -->
                    <TextBlock Grid.Row="1" Text="{Binding StatusText}"
                               FontSize="11.5" Foreground="#64748B"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Top" Margin="0,14,0,0"
                               Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}" />

                    <!-- Private by Design Badge -->
                    <Border Grid.Row="2" Background="#0D1117" BorderBrush="#21262D" BorderThickness="1"
                            CornerRadius="10" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔒" FontSize="15" Margin="0,2,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Private by design" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,2" />
                                <TextBlock Text="Audio and transcription stay on this device." FontSize="11" Foreground="#64748B" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>

                <Border Grid.Column="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                        CornerRadius="14" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Feed Header -->
                            <RowDefinition Height="*" />    <!-- Feed List / Empty State -->
                            <RowDefinition Height="Auto" /> <!-- Live Transcript Toggle Button -->
                            <RowDefinition Height="Auto" /> <!-- Live Transcript Panel -->
                        </Grid.RowDefinitions>

                        <!-- Feed Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Recent Mentions" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Border Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalMentionsCount}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                            </StackPanel>

                            <!-- Clear Mentions Action -->
                            <Button Grid.Column="1" Command="{Binding ClearMentionsCommand}"
                                    Visibility="{Binding TotalMentionsCount, Converter={StaticResource CountToVis}}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#64748B" FontSize="12" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#EF4444" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️" Margin="0,0,4,0" FontSize="11" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty State -->
                        <Grid Grid.Row="1" Visibility="{Binding TotalMentionsCount, Converter={StaticResource InverseCountToVis}}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <Border Background="#1E293B" CornerRadius="28" Width="56" Height="56" Margin="0,0,0,16" HorizontalAlignment="Center">
                                    <TextBlock Text="💬" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="No mentions detected yet" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="When your name is spoken in a meeting, stream, or video call, it will appear here."
                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" LineHeight="18" />
                            </StackPanel>
                        </Grid>

                        <!-- Mentions List Feed -->
                        <ScrollViewer Grid.Row="1"
                                      Visibility="{Binding TotalMentionsCount, Converter={StaticResource CountToVis}}"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentMentions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D1117" BorderBrush="#21262D" BorderThickness="1"
                                                CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#0C4A6E" BorderBrush="#0284C7" BorderThickness="1"
                                                                CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding MatchedName, StringFormat='🎯 {0}'}"
                                                                       FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedTime}"
                                                               FontSize="11" Foreground="#475569" VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Card Body: Sentence -->
                                                <TextBlock Grid.Row="1" Text="{Binding Sentence, StringFormat='&quot;{0}&quot;'}"
                                                           FontSize="13.5" Foreground="#F1F5F9" FontWeight="Medium"
                                                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8" />

                                                <!-- Card Footer: Copy Button only -->
                                                <Grid Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding AudioSource}" FontSize="10.5" Foreground="#475569" VerticalAlignment="Center" />

                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.CopyMentionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="#1E293B" Foreground="#94A3B8"
                                                            BorderThickness="0" Padding="8,3" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4" />
                                                            </Style>
                                                        </Button.Resources>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📋" FontSize="10" Margin="0,0,4,0" />
                                                            <TextBlock Text="Copy" FontSize="11" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Live Transcription Toggle Button (visible only when listening) -->
                        <Button Grid.Row="2" Command="{Binding ToggleLiveTranscriptCommand}"
                                Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}"
                                Cursor="Hand" Margin="0,10,0,0" HorizontalAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#64748B" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#94A3B8" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📝" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding LiveTranscriptButtonText}" FontSize="12" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Live Transcript Log Panel -->
                        <Border Grid.Row="3"
                                Visibility="{Binding IsLiveTranscriptVisible, Converter={StaticResource BoolToVis}}"
                                Background="#0D1117" BorderBrush="#21262D" BorderThickness="1"
                                CornerRadius="10" Margin="0,10,0,0" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Live Transcription" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#475569" VerticalAlignment="Center" />

                                    <Button Grid.Column="1" Command="{Binding CopyTranscriptCommand}"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="#475569" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📋" FontSize="10" Margin="0,0,4,0" />
                                            <TextBlock Text="Copy all" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                                              x:Name="TranscriptScrollViewer">
                                    <ItemsControl ItemsSource="{Binding LiveTranscriptLog}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="#94A3B8"
                                                           FontFamily="Cascadia Mono, Consolas, monospace"
                                                           TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,4" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Edit Name Popup -->
        <Grid Background="#B3000000" Visibility="{Binding IsEditPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="14" Width="340" Padding="20"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Edit name" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                    <TextBox Text="{Binding EditingNameText, UpdateSourceTrigger=PropertyChanged}"
                             Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#3B82F6"
                             BorderThickness="1.5" Padding="10,8" FontSize="13" CaretBrush="#60A5FA">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SaveEditedNameCommand}" />
                            <KeyBinding Key="Escape" Command="{Binding CancelEditNameCommand}" />
                        </TextBox.InputBindings>
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8" /></Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding CancelEditNameCommand}"
                                Height="36" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="BorderBrush" Value="#334155" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Cancel" FontSize="12.5" FontWeight="Medium" />
                        </Button>

                        <Button Grid.Column="2" Command="{Binding SaveEditedNameCommand}"
                                Height="36" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Save" FontSize="12.5" FontWeight="SemiBold" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. Settings Slide-Over Drawer Modal -->
        <Grid Background="#B3000000" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                    CornerRadius="16" Width="440" MaxHeight="600"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Settings Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding ToggleSettingsCommand}"
                                Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                                Content="✕" FontSize="16" Cursor="Hand" />
                    </Grid>

                    <!-- Settings Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" BorderThickness="0" Focusable="False" Background="Transparent">
                        <StackPanel>
                            <!-- Primary Name -->
                            <TextBlock Text="Primary name" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,4" />
                            <TextBox Text="{Binding PrimaryName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0D1117" Foreground="#FFFFFF" BorderBrush="#334155" Padding="10,8" Margin="0,0,0,14">
                                <TextBox.Resources>
                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Additional Names -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Additional names" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                        CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AdditionalNamesCountText}" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" />
                                </Border>
                            </Grid>

                            <!-- Chips / Tags for Additional Names with Delete button -->
                            <ItemsControl ItemsSource="{Binding AdditionalNamesList}" Margin="0,0,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                CornerRadius="14" Padding="10,5" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <Button Command="{Binding DataContext.RemoveAdditionalNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="#94A3B8" FontSize="11" FontWeight="Bold"
                                                        Cursor="Hand" VerticalAlignment="Center" Padding="2,0">
                                                    <TextBlock Text="✕" FontSize="10" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Input Row for adding an additional name (press Enter or click + Add) -->
                            <Grid Margin="0,0,0,16" Visibility="{Binding CanAddMoreAdditionalNames, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Text="{Binding NewAdditionalNameInput, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12.5" FontWeight="Medium"
                                         Background="#0D1117" Foreground="#FFFFFF"
                                         BorderBrush="#334155" BorderThickness="1"
                                         Padding="10,7" Margin="0,0,6,0"
                                         CaretBrush="#60A5FA">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddAdditionalNameCommand}" />
                                    </TextBox.InputBindings>
                                    <TextBox.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                    </TextBox.Resources>
                                </TextBox>

                                <Button Grid.Column="1" Command="{Binding AddAdditionalNameCommand}"
                                        IsEnabled="{Binding CanAddAdditionalName}"
                                        Content="+ Add" FontSize="11.5" FontWeight="SemiBold"
                                        Background="#2563EB" Foreground="#FFFFFF"
                                        BorderThickness="0" Padding="12,0" Height="32"
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>


                            <!-- Toast Notification Sound Toggle -->
                            <CheckBox IsChecked="{Binding PlayNotificationSound}"
                                      Content="Play sound on Windows notification"
                                      Foreground="#E2E8F0" Margin="0,0,0,10" />

                            <!-- Always on top toggle -->
                            <CheckBox IsChecked="{Binding KeepWindowAlwaysOnTop}"
                                      Content="Keep window always on top"
                                      Foreground="#E2E8F0" Margin="0,0,0,16" />

                            <!-- Mobile Companion (Android Sync) Section -->
                            <Border Background="#0D1117" BorderBrush="#30363D" BorderThickness="1"
                                    CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📱" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Mobile Companion" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1"
                                                CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                    </Grid>

                                    <!-- Unpaired State: Enter Code -->
                                    <StackPanel Visibility="{Binding IsMobilePaired, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                                        <TextBlock Text="Pair with your Android app to get push alerts when away from desk."
                                                   FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding PairingCodeInput, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12.5" FontWeight="SemiBold"
                                                     Background="#161B22" Foreground="#FFFFFF"
                                                     BorderBrush="#334155" BorderThickness="1"
                                                     Padding="10,7" Margin="0,0,6,0"
                                                     CaretBrush="#60A5FA">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding PairMobileCommand}" />
                                                </TextBox.InputBindings>
                                                <TextBox.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                                </TextBox.Resources>
                                            </TextBox>
                                            <Button Grid.Column="1" Command="{Binding PairMobileCommand}"
                                                    IsEnabled="{Binding IsPairingInProgress, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"
                                                    Content="Link Phone" FontSize="11.5" FontWeight="SemiBold"
                                                    Background="#2563EB" Foreground="#FFFFFF"
                                                    BorderThickness="0" Padding="12,0" Height="32"
                                                    Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Paired State -->
                                    <StackPanel Visibility="{Binding IsMobilePaired, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🟢" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PairedDeviceName}" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding UnlinkMobileCommand}"
                                                    Content="Unlink" FontSize="11" FontWeight="Medium"
                                                    Background="#334155" Foreground="#CBD5E1"
                                                    BorderThickness="0" Padding="8,4" Cursor="Hand">
                                                <Button.Resources>
                                                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="6" /></Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>

                                        <CheckBox IsChecked="{Binding MobileSyncEnabled}"
                                                  Content="Send instant push notifications to phone"
                                                  Foreground="#E2E8F0" FontSize="11.5" Margin="0,2,0,4" />
                                    </StackPanel>

                                    <!-- Status message -->
                                    <TextBlock Text="{Binding MobilePairingStatusText}"
                                               FontSize="11" Foreground="#38BDF8" TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings Footer (Aligned Action Row) -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Test Notification Button (Left) -->
                        <Button Grid.Column="0" Command="{Binding TestNotificationCommand}"
                                Height="36" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#1E293B" />
                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                    <Setter Property="BorderBrush" Value="#334155" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="12,0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#334155" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔔" Margin="0,0,6,0" FontSize="11" />
                                <TextBlock Text="Test notification" FontSize="12" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Done Button (Right) -->
                        <Button Grid.Column="2" Command="{Binding ToggleSettingsCommand}"
                                Height="36" Width="90" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2563EB" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="8">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1D4ED8" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Done" FontSize="12.5" FontWeight="SemiBold" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Model Download Progress Overlay -->
        <Grid Background="#CC000000" Visibility="{Binding IsDownloadingModel, Converter={StaticResource BoolToVis}}">
            <Border Background="#161B22" BorderBrush="#3B82F6" BorderThickness="1"
                    CornerRadius="16" Width="380" Padding="24"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Setting up Whisper Model" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="One-time fast download for local on-device speech recognition."
                               FontSize="12" Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Download Progress Bar -->
                    <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                                 Height="10" Foreground="#3B82F6" Background="#0D1117"
                                 BorderBrush="#1E293B" BorderThickness="1" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding DownloadStatusText}" FontSize="12" Foreground="#38BDF8" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
